+def coplanar_rotation(ahead, Bn, Vs, gamma):
+    """The rotational discontinuity a COPLANAR state admits, in closed form:
+    the tangential field turned through pi in the fluid frame, which in the
+    lab lands on EITHER sign of B_t.
+
+    `exact_rotation`'s construction at the lab angles psi_ahead + pi (the field
+    reversed in the lab) and psi_ahead (the same lab sign: one intersection is
+    the identity, the other the rotation), the identity excluded.  The
+    reversal production asks for (``seed_rot(state, pi)``, planar5's
+    ``_reverse``) finds only the first kind; on the near-normal faces of the
+    2D runs the rotation keeps the lab sign on about half the sides (failure
+    ledger 4Q 128^2, 2026-11-05: lanes 166 and 1013, right side), and a
+    four-unknown answer without it fuses the rotation into its slow jump --
+    one that lowers the entropy by 1e-9..7e-5.
+
+    Returns ``(behind, err)``; ``err`` marks lanes with neither rotation.
+    """
+    rho, P, vx, vy, vz, By, Bz = (np.asarray(c, dtype=float) for c in ahead)
+    n = rho.shape[0]
+    best = [np.array(x, dtype=float, copy=True) for x in ahead]
+    found = np.zeros(n, dtype=bool)
+    with np.errstate(all="ignore"):
+        W = 1.0 / np.sqrt(np.maximum(1.0 - (vx * vx + vy * vy + vz * vz), 1e-300))
+        vB = vx * Bn + vy * By + vz * Bz
+        b = np.stack([W * vB, Bn / W + W * vB * vx, By / W + W * vB * vy,
+                      Bz / W + W * vB * vz], axis=1)
+        b2 = (Bn * Bn + By * By + Bz * Bz) / (W * W) + vB * vB
+        sE = np.sqrt(np.maximum(rho * WB.enthalpy(P - 0.5 * b2, rho, gamma) + b2, 0.0))
+        u = np.stack([W, W * vx, W * vy, W * vz], axis=1)
+        qp, qm = b + sE[:, None] * u, b - sE[:, None] * u
+        s = np.where(np.abs(qp[:, 1] / qp[:, 0] - Vs) < np.abs(qm[:, 1] / qm[:, 0] - Vs),
+                     1.0, -1.0)
+        q = np.where(s[:, None] > 0, qp, qm)
+        psi_a = np.arctan2(Bz, By)
+        for psi in (psi_a + np.pi, psi_a):
+            c, sn = np.cos(psi), np.sin(psi)
+            A = np.zeros((n, 3, 4))
+            A[:, 0, 0], A[:, 0, 1], A[:, 0, 2], A[:, 0, 3] = -q[:, 0], q[:, 1], q[:, 2], q[:, 3]
+            A[:, 1, 0], A[:, 1, 1] = q[:, 1], -q[:, 0]
+            A[:, 2, 0] = q[:, 2] * sn - q[:, 3] * c
+            A[:, 2, 2], A[:, 2, 3] = -q[:, 0] * sn, q[:, 0] * c
+            r = np.stack([-s * sE, Bn, np.zeros(n)], axis=1)
+            At = np.transpose(A, (0, 2, 1))
+            AAt = A @ At
+            sing = ~np.isfinite(AAt).all(axis=(1, 2)) | (np.abs(np.linalg.det(
+                np.where(np.isfinite(AAt), AAt, 0.0))) <= 1e-300)
+            AAt[sing] = np.eye(3)
+            up = (At @ np.linalg.solve(AAt, r[..., None]))[..., 0]
+            d = np.stack([(-1.0) ** k * np.linalg.det(np.delete(A, k, axis=2))
+                          for k in range(4)], axis=1)
+            a2 = (_MINK * d * d).sum(axis=1)
+            a1 = 2.0 * (_MINK * up * d).sum(axis=1)
+            a0 = (_MINK * up * up).sum(axis=1) + 1.0
+            root = np.sqrt(a1 * a1 - 4.0 * a2 * a0)
+            for t in ((-a1 - root) / (2.0 * a2), (-a1 + root) / (2.0 * a2)):
