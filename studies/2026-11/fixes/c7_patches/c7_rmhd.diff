+                vb = U[:, 1:] / U[:, :1]
+                By_b = q[:, 2] * U[:, 0] - q[:, 0] * U[:, 2]
+                Bz_b = q[:, 3] * U[:, 0] - q[:, 0] * U[:, 3]
+                same = np.max(np.abs(U - u), axis=1) <= 1e-9 * np.max(np.abs(u), axis=1)
+                ok = (~found & ~sing & np.isfinite(U).all(axis=1) & (U[:, 0] >= 1.0)
+                      & ((vb * vb).sum(axis=1) < 1.0) & (By_b * c + Bz_b * sn > 0.0)
+                      & ~same)
+                for k, val in ((2, vb[:, 0]), (3, vb[:, 1]), (4, vb[:, 2]),
+                               (5, By_b), (6, Bz_b)):
