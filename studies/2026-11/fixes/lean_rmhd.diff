 _DRIVERS = {}
 
 
+def make_signed(gamma):
+    """``fan_signed(target_Bt, init, switch, Bx, nsteps)`` compiled: the
+    driver of `_make_driver_signed`, same contract as the numpy loop in
+    planar4_b.fan_signed before its pressure check."""
