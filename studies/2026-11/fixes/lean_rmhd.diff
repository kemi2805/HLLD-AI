+    if "s" not in _DRIVERS:
+        _DRIVERS["s"] = _make_driver_signed(xi_c, rhs_p)
+
+    def fan_signed(target, init, switch, Bx, g=gamma, nsteps=500):
+        init7 = np.stack([np.asarray(c, dtype=float) for c in init], axis=0)
+        N = init7.shape[1]
+        tgt = np.broadcast_to(np.asarray(target, dtype=float), (N,)).astype(float)
+        Bxa = np.broadcast_to(np.asarray(Bx, dtype=float), (N,)).astype(float)
+        out = np.full((7, N), np.nan)
+        Vs = np.full(N, np.nan)
+        err = np.ones(N, dtype=np.bool_)
+        _DRIVERS["s"](_K[switch], tgt, np.ascontiguousarray(init7), Bxa,
+                      float(g), int(nsteps), out, Vs, err)
+        return [out[j] for j in range(7)], Vs, err
+
+    return fan_signed
