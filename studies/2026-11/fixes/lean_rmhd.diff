+def _make_driver_signed(xi_c, rhs_c):
+    """The compiled lane loop of planar4_b.fan_signed: the pressure fan's ODE
+    re-parametrised by the signed tangential field, ``dy/dB_t = rhs_p /
+    rhs_p[B_t]``, fixed-step RK4 from ``init[5]`` to ``target``; the same
+    freezing on a superluminal or non-finite stage as the other drivers."""
+
+    @njit(cache=False, error_model="numpy")
+    def _f(y, k, Bx, gamma):
+        v2 = y[2] * y[2] + y[3] * y[3] + y[4] * y[4]
+        if (not math.isfinite(v2)) or v2 >= 1.0:
+            return (math.nan, math.nan, math.nan, math.nan, math.nan, math.nan, math.nan)
+        d = rhs_c(y[1], y, k, Bx, gamma)
+        inv = 1.0 / d[5]
+        return (d[0] * inv, d[1] * inv, d[2] * inv, d[3] * inv, d[4] * inv,
+                d[5] * inv, d[6] * inv)
+
+    @njit(parallel=True, cache=False, error_model="numpy")
+    def driver(k, target, init, Bx, gamma, nsteps, out, Vs_out, err_out):
+        N = target.shape[0]
+        for n in prange(N):
+            y = (init[0, n], init[1, n], init[2, n], init[3, n], init[4, n],
+                 init[5, n], init[6, n])
+            x0 = init[5, n]
+            tgt = target[n]
+            Vs_out[n] = xi_c(y, k, Bx[n], gamma)
+            unchanged = abs(tgt - x0) <= 1e-15 * max(abs(tgt), 1.0)
+            h = 0.0 if unchanged else (tgt - x0) / nsteps
+            err = False
+            for _ in range(nsteps):
+                if err:
+                    break
+                k1 = _f(y, k, Bx[n], gamma)
+                y2 = (y[0] + 0.5 * h * k1[0], y[1] + 0.5 * h * k1[1],
+                      y[2] + 0.5 * h * k1[2], y[3] + 0.5 * h * k1[3],
+                      y[4] + 0.5 * h * k1[4], y[5] + 0.5 * h * k1[5],
+                      y[6] + 0.5 * h * k1[6])
+                k2 = _f(y2, k, Bx[n], gamma)
+                y3 = (y[0] + 0.5 * h * k2[0], y[1] + 0.5 * h * k2[1],
+                      y[2] + 0.5 * h * k2[2], y[3] + 0.5 * h * k2[3],
+                      y[4] + 0.5 * h * k2[4], y[5] + 0.5 * h * k2[5],
+                      y[6] + 0.5 * h * k2[6])
+                k3 = _f(y3, k, Bx[n], gamma)
+                y4 = (y[0] + h * k3[0], y[1] + h * k3[1], y[2] + h * k3[2],
+                      y[3] + h * k3[3], y[4] + h * k3[4], y[5] + h * k3[5],
+                      y[6] + h * k3[6])
+                k4 = _f(y4, k, Bx[n], gamma)
+                h6 = h / 6.0
+                yn = (y[0] + h6 * (k1[0] + 2.0 * k2[0] + 2.0 * k3[0] + k4[0]),
+                      y[1] + h6 * (k1[1] + 2.0 * k2[1] + 2.0 * k3[1] + k4[1]),
+                      y[2] + h6 * (k1[2] + 2.0 * k2[2] + 2.0 * k3[2] + k4[2]),
+                      y[3] + h6 * (k1[3] + 2.0 * k2[3] + 2.0 * k3[3] + k4[3]),
+                      y[4] + h6 * (k1[4] + 2.0 * k2[4] + 2.0 * k3[4] + k4[4]),
+                      y[5] + h6 * (k1[5] + 2.0 * k2[5] + 2.0 * k3[5] + k4[5]),
+                      y[6] + h6 * (k1[6] + 2.0 * k2[6] + 2.0 * k3[6] + k4[6]))
+                v2 = yn[2] * yn[2] + yn[3] * yn[3] + yn[4] * yn[4]
+                bad = (not math.isfinite(v2)) or v2 >= 1.0
+                for j in range(7):
+                    if not math.isfinite(yn[j]):
+                        bad = True
+                if bad:
+                    err = True            # freeze at the last good state
+                else:
+                    y = yn
+            for j in range(7):
+                out[j, n] = y[j]
+            err_out[n] = err
+
+    return driver
