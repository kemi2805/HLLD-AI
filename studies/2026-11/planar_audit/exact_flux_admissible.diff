+def _inadmissible(left, Zc, right, VL, VR, Bn, gamma, shocks=None):
+    """Per lane, the reasons the fan is not an admissible Riemann solution
+    (see _ADMISSIBLE): a bool mask per test, ``entropy``, ``lax``, ``order``,
+    and their union ``any``.
+
+    ``left``/``right`` are the outer states, ``Zc`` the six zones R2..R7 and
+    ``VL``/``VR`` the ``[LF, LA, LS]`` / ``[RF, RA, RS]`` speeds, as for
+    `_self_crossing` (a fan's speed is its head).  ``shocks`` (4, N) over
+    ``[LF, LS, RS, RF]`` overrides the shock/fan predicates the five- and
+    seven-wave solvers build with (fast: the total pressure rises; slow:
+    |B_t| falls) -- the four-unknown solver steers some slow waves by
+    pressure, and there |B_t| does not say which it built.
+    """
+    import numpy as np
+    from rmhd.batched import wave_speeds_b as WB
+    R = [left] + list(Zc) + [right]                      # R1 .. R8
+    n = np.asarray(Bn).shape[0]
+    bc = lambda a: np.broadcast_to(np.asarray(a, dtype=float), (n,))
+    R = [[bc(c) for c in s] for s in R]
+    Bn = bc(Bn)
+
+    def entropy(s):
+        rho, P, vx, vy, vz, By, Bz = s
+        v2 = vx * vx + vy * vy + vz * vz
+        eta = Bn * vx + By * vy + Bz * vz
+        b2 = (Bn * Bn + By * By + Bz * Bz) * (1.0 - v2) + eta * eta
+        return (P - 0.5 * b2) / rho ** gamma
+
+    def strength(a, b):
+        sP = np.sqrt(2.0 * np.maximum(np.maximum(a[1], b[1]), 1e-300))
+        return np.maximum.reduce([
+            np.abs(b[0] - a[0]) / np.abs(a[0]), np.abs(b[1] - a[1]) / np.abs(a[1]),
+            np.sqrt((b[2] - a[2]) ** 2 + (b[3] - a[3]) ** 2 + (b[4] - a[4]) ** 2),
+            np.hypot(b[5] - a[5], b[6] - a[6]) / sP])
+
+    with np.errstate(all="ignore"):
+        E = [WB.xi_all(*R[k], Bn, gamma) for k in range(8)]   # (eig, la, ra, ok)
+        lam = lambda k, f: np.asarray(E[k][0])[:, f]
+        ok = lambda k, f: np.asarray(E[k][3])[:, f]
+        la = lambda k: np.asarray(E[k][1])
+        ra = lambda k: np.asarray(E[k][2])
+        K = [entropy(R[k]) for k in range(8)]
+        bad_e = np.zeros(n, dtype=bool)
+        bad_l = np.zeros(n, dtype=bool)
+        ends = {}
+        #        name, ahead, behind, speed, family (LF LS RS RF), fast
+        for row, (name, a, b, s, f, fast) in enumerate((
+                ("LF", 0, 1, VL[0], 0, True), ("LS", 2, 3, VL[2], 1, False),
+                ("RS", 5, 4, VR[2], 2, False), ("RF", 7, 6, VR[0], 3, True))):
+            A, B = R[a], R[b]
+            s = bc(s)
+            if shocks is not None:
+                sh = np.asarray(shocks[row], dtype=bool)
+            elif fast:
+                sh = B[1] > A[1] * (1.0 + 1e-14)
+            else:
+                sh = np.hypot(B[5], B[6]) < np.hypot(A[5], A[6]) * (1.0 - 1e-12)
+            live = strength(A, B) > 1e-10
+            sh = sh & live
+            bad_e |= sh & (K[b] < K[a] * (1.0 - _ADM_ENTROPY_TOL))
+            # Lax, written with U_l / U_r the states left / right of the wave
+            if name == "LF":
+                m = [lam(a, f) - s, s - lam(b, f), la(b) - s]
+            elif name == "LS":
+                m = [lam(a, f) - s, s - lam(b, f), s - la(a), B[2] - s]
+            elif name == "RS":
+                m = [lam(b, f) - s, s - lam(a, f), s - B[2], ra(a) - s]
+            else:
+                m = [lam(b, f) - s, s - lam(a, f), s - ra(b)]
+            trusted = ok(a, f) & ok(b, f)
+            bad_l |= sh & trusted & (np.min(np.stack(m), axis=0) < -_ADM_LAX_TOL)
+            # the wave's extent: a shock at its speed, a fan head to tail
+            head, tail = lam(a, f), lam(b, f)
+            lo = np.where(sh, s, np.minimum(head, tail))
+            hi = np.where(sh, s, np.maximum(head, tail))
+            ends[name] = (lo, hi, live)
+        lo_lf, hi_lf, on_lf = ends["LF"]
+        lo_ls, hi_ls, on_ls = ends["LS"]
+        lo_rs, hi_rs, on_rs = ends["RS"]
+        lo_rf, hi_rf, on_rf = ends["RF"]
+        tol = _WAVE_ORDER_TOL
+        bad_o = (on_lf & on_ls & (lo_ls < hi_lf - tol)) | (on_rs & on_rf & (hi_rs > lo_rf + tol))
+    return dict(entropy=bad_e, lax=bad_l, order=bad_o, any=bad_e | bad_l | bad_o)
+
